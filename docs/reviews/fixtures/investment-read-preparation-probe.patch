+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql/driver"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"rekenraam/backend/internal/db"
+	"sort"
+	"strings"
+	"time"
+)
+
+type Query struct {
+	Phase    string `json:"phase"`
+	Caller   string `json:"caller"`
+	Location string `json:"location"`
+	SQL      string `json:"sql"`
+	Args     []any  `json:"args"`
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+func run() error {
+	ctx := context.Background()
+	files, e := filepath.Glob(filepath.Join(os.Args[1], "fixture-*-queries.json"))
+	if e != nil {
+		return e
+	}
+	var results []map[string]any
+	for _, file := range files {
+		var queries []Query
+		f, e := os.Open(file)
+		if e != nil {
+			return e
+		}
+		d := json.NewDecoder(f)
+		d.UseNumber()
+		e = d.Decode(&queries)
+		f.Close()
+		if e != nil {
+			return e
+		}
+		database, e := db.Open(ctx, db.SQLiteFileURL(strings.TrimSuffix(file, "-queries.json")+".sqlite"))
+		if e != nil {
+			return e
+		}
+		conn, e := database.Conn(ctx)
+		if e != nil {
+			return e
+		}
+		seen := map[string]bool{}
+		for _, q := range queries {
+			argJSON, _ := json.Marshal(q.Args)
+			key := q.SQL + string(argJSON)
+			if seen[key] {
+				continue
+			}
+			seen[key] = true
+			if only := os.Getenv("QUERY445_ONLY"); only != "" && !strings.Contains(q.Caller, only) {
+				continue
+			}
+			args := make([]driver.Value, len(q.Args))
+			for i, v := range q.Args {
+				if n, ok := v.(json.Number); ok {
+					number, e := n.Int64()
+					if e != nil {
+						return e
+					}
+					args[i] = number
+				} else {
+					args[i] = v
+				}
+			}
+			var prepares, executes []float64
+			var count int
+			var fingerprint string
+			err := conn.Raw(func(raw any) error {
+				native := raw.(driver.Conn)
+				for batch := 0; batch < 5; batch++ {
+					before := time.Now()
+					for i := 0; i < 100; i++ {
+						s, e := native.Prepare(q.SQL)
+						if e != nil {
+							return e
+						}
+						if e = s.Close(); e != nil {
+							return e
+						}
+					}
+					prepares = append(prepares, float64(time.Since(before).Nanoseconds())/100/1e3)
+				}
+				s, e := native.Prepare(q.SQL)
+				if e != nil {
+					return e
+				}
+				defer s.Close()
+				read := func(hash bool) (int, string, error) {
+					rows, e := s.Query(args)
+					if e != nil {
+						return 0, "", e
+					}
+					defer rows.Close()
+					values := make([]driver.Value, len(rows.Columns()))
+					n := 0
+					h := sha256.New()
+					for {
+						e := rows.Next(values)
+						if e == io.EOF {
+							break
+						}
+						if e != nil {
+							return 0, "", e
+						}
+						n++
+						if hash {
+							body, e := json.Marshal(values)
+							if e != nil {
+								return 0, "", e
+							}
+							h.Write(body)
+						}
+					}
+					return n, fmt.Sprintf("%x", h.Sum(nil)), nil
+				}
+				count, fingerprint, e = read(true)
+				if e != nil {
+					return e
+				}
+				for batch := 0; batch < 5; batch++ {
+					before := time.Now()
+					for i := 0; i < 20; i++ {
+						n, _, e := read(false)
+						if e != nil {
+							return e
+						}
+						if n != count {
+							return fmt.Errorf("unstable row count")
+						}
+					}
+					executes = append(executes, float64(time.Since(before).Nanoseconds())/20/1e6)
+				}
+				return nil
+			})
+			if err != nil {
+				return fmt.Errorf("%s: %w", q.Caller, err)
+			}
+			prep := append([]float64(nil), prepares...)
+			sort.Float64s(prep)
+			exec := append([]float64(nil), executes...)
+			sort.Float64s(exec)
+			row := map[string]any{"fixture": filepath.Base(file), "phase": q.Phase, "caller": q.Caller, "location": q.Location, "sql": q.SQL, "sql_sha256": fmt.Sprintf("%x", sha256.Sum256([]byte(q.SQL))), "args": q.Args, "prepare_us": prepares, "prepare_median_us": prep[2], "execute_ms": executes, "execute_median_ms": exec[2], "rows": count, "rows_sha256": fingerprint}
+			results = append(results, row)
+		}
+		conn.Close()
+		database.Close()
+		fmt.Println(filepath.Base(file), "queries", len(seen))
+	}
+	b, e := json.MarshalIndent(results, "", "  ")
+	if e != nil {
+		return e
+	}
+	return os.WriteFile(os.Args[2], append(b, '\n'), 0600)
+}
