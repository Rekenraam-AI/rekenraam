+		input := InternalTransferInput{OwnerUserID: f.ownerUserID, EffectiveOn: date, SourceAccountID: f.holdingAccountID, DestinationAccountID: destination, CommodityID: f.stockCommodityID, CostCommodityID: f.eurCommodityID, Allocations: allocations, SourceEvidenceJSON: `{"source":"owner"}`, ChangeReason: "measurement"}
+		_, err := f.investmentService.InternalTransfer(ctx, input)
+		require.NoError(t, err)
+		requireInvestmentSelfCheckPasses(t, f)
+		return nil
+	}})
+	large := scenarios[len(scenarios)-1]
+	scenarios = append(scenarios, struct {
+		name   string
+		record func(*testing.T, *investmentsTestFixture) []recordedOperation
+	}{"reversed fifty-lot transfer", func(t *testing.T, f *investmentsTestFixture) []recordedOperation {
+		large.record(t, f)
+		var transactionID int64
+		require.NoError(t, f.database.QueryRow(`SELECT v.transaction_id FROM investment_operations o JOIN investment_operation_journal_links l ON l.operation_id=o.id AND l.role='primary' JOIN transaction_versions v ON v.id=l.transaction_version_id WHERE o.operation_kind='internal_transfer'`).Scan(&transactionID))
+		_, err := acknowledgedReverseTransfer(ctx, f.investmentService, reverseTransferInput(f, transactionID))
+		require.NoError(t, err)
+		requireInvestmentSelfCheckPasses(t, f)
+		return nil
+	}})
+	for i, scenario := range scenarios {
+		f := newInvestmentsTestFixture(t)
+		scenario.record(t, f)
+		for _, filter := range []db.EffectiveMovementFilter{{}, {PositionSide: "long"}, {PositionSide: "short"}, {DisposalsOnly: true}} {
+			db.Capture445Phase("movements")
+			_, err := db.EffectiveLotMovements(ctx, f.database, BookID, filter)
+			require.NoError(t, err)
+		}
+		db.Capture445Phase("")
+		positions, err := f.database.Query(`SELECT DISTINCT account_id,commodity_id,cost_commodity_id,position_side FROM investment_lots`)
+		require.NoError(t, err)
+		type position struct {
+			account, commodity, cost int64
+			side                     string
+		}
+		var ps []position
+		for positions.Next() {
+			var p position
+			require.NoError(t, positions.Scan(&p.account, &p.commodity, &p.cost, &p.side))
+			ps = append(ps, p)
+		}
+		require.NoError(t, positions.Close())
+		for _, p := range ps {
+			db.Capture445Phase("replay")
+			_, err := db.NewInvestmentRepository(f.database).ListInvestmentReplayIntents(ctx, BookID, p.account, p.commodity, p.cost, p.side)
+			require.NoError(t, err)
