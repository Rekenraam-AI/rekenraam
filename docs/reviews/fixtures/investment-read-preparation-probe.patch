+		body, err := json.MarshalIndent(map[string]any{"name": scenario.name, "counts": counts}, "", "  ")
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(base+"-info.json", body, 0600))
+	}
+}
+func dbURL445(t *testing.T, f *investmentsTestFixture) string {
