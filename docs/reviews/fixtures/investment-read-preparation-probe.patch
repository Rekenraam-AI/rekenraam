+		require.NoError(t, err)
+		snapshot, err := reader.BeginTx(ctx, nil)
+		require.NoError(t, err)
+		db.Capture445Phase("foundation")
+		service := NewSelfCheckService(db.NewSelfCheckRepository(f.database, reader))
+		_, err = service.investmentFoundationCheck(db.WithReferenceDate(ctx, "2026-10-29"), snapshot)
+		require.NoError(t, err)
+		db.Capture445Phase("")
+		require.NoError(t, snapshot.Rollback())
+		require.NoError(t, reader.Close())
+		base := filepath.Join(out, fmt.Sprintf("fixture-%d", i))
+		require.NoError(t, db.Capture445Save(base+"-queries.json"))
+		require.NoError(t, db.BackupSQLiteDatabase(ctx, f.database, base+".sqlite"))
+		counts := map[string]int{}
+		for _, table := range []string{"investment_operations", "investment_lots", "investment_lot_events", "investment_disposal_revisions", "investment_transfer_link_revisions", "transaction_versions", "posting_versions"} {
+			var n int
