+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"rekenraam/backend/internal/db"
+	"strings"
+)
+
+type query struct {
+	Caller, SQL string
+	Args        []any
+}
+
+func main() {
+	if e := run(); e != nil {
+		panic(e)
+	}
+}
+func run() error {
+	files, _ := filepath.Glob(filepath.Join(os.Args[1], "fixture-*-queries.json"))
+	var out []map[string]any
+	for _, file := range files {
+		f, e := os.Open(file)
+		if e != nil {
+			return e
+		}
+		d := json.NewDecoder(f)
+		d.UseNumber()
+		var qs []query
+		e = d.Decode(&qs)
+		f.Close()
+		if e != nil {
+			return e
+		}
+		database, e := db.Open(context.Background(), db.SQLiteFileURL(strings.TrimSuffix(file, "-queries.json")+".sqlite"))
+		if e != nil {
+			return e
+		}
+		for _, q := range qs {
+			for i, v := range q.Args {
+				if n, ok := v.(json.Number); ok {
+					q.Args[i], e = n.Int64()
+					if e != nil {
+						return e
+					}
+				}
+			}
+			rows, e := database.Query("EXPLAIN QUERY PLAN "+q.SQL, q.Args...)
+			if e != nil {
+				return e
+			}
+			var plan []string
+			for rows.Next() {
+				var id, parent, unused int
+				var detail string
+				if e = rows.Scan(&id, &parent, &unused, &detail); e != nil {
+					return e
+				}
+				plan = append(plan, detail)
+			}
+			if e = rows.Close(); e != nil {
+				return e
+			}
+			out = append(out, map[string]any{"fixture": filepath.Base(file), "caller": q.Caller, "args": q.Args, "plan": plan})
+		}
+		database.Close()
+	}
+	b, e := json.MarshalIndent(out, "", "  ")
+	if e != nil {
+		return e
+	}
+	fmt.Println(string(b))
+	return nil
+}
