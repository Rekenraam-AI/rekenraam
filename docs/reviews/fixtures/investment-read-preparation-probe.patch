+package db
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"os"
+	"runtime"
+)
+
+var capture445Phase string
+var capture445Rows []map[string]any
+
+func Capture445Phase(phase string) { capture445Phase = phase }
+func Capture445Save(path string) error {
+	b, e := json.MarshalIndent(capture445Rows, "", "  ")
+	if e != nil {
+		return e
+	}
+	capture445Rows = nil
+	return os.WriteFile(path, b, 0600)
+}
+func capture445Query(ctx context.Context, source interface {
+	QueryContext(context.Context, string, ...any) (*sql.Rows, error)
+}, query string, args ...any) (*sql.Rows, error) {
+	if capture445Phase != "" {
+		pc, file, line, _ := runtime.Caller(1)
+		capture445Rows = append(capture445Rows, map[string]any{"phase": capture445Phase, "caller": runtime.FuncForPC(pc).Name(), "location": fmt.Sprintf("%s:%d", file, line), "sql": query, "args": args})
+	}
+	return source.QueryContext(ctx, query, args...)
+}
