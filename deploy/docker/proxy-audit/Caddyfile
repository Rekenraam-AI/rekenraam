# Disposable audit proxy (#268). This is the docs/deployment-security.md
# example with one change: `tls internal` issues the certificate from Caddy's
# own local CA instead of a public ACME CA, so no real domain is needed.
rekenraam.test {
	tls internal
	reverse_proxy rekenraam:16888 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
